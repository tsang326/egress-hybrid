rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Shared drills: anyone with the link can read; a signed-in (anonymous) visitor can create one,
    // never change or delete someone else's, and only within a size budget.
    match /shares/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.keys().hasOnly(['owner', 'createdAt', 'v', 'payload'])
        && request.resource.data.v == 1
        && request.resource.data.payload is string
        && request.resource.data.payload.size() < 400000
        && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
